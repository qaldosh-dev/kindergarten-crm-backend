# Copy values into your local shell or the coordinator-owned compose environment.
# Database must already exist; Flyway creates its schema and baseline age tariffs.
DB_URL=jdbc:postgresql://localhost:5433/kindergarten
DB_USER=kindergarten
DB_PASSWORD=replace-with-database-password

# Production: random secret of at least 32 UTF-8 bytes. Never commit a real secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Required only when creating the first production administrator.
ADMIN_LOGIN=owner@example.invalid
ADMIN_PASSWORD=replace-with-strong-initial-password
# Leave empty for production. Enable demo explicitly on a separate database.
SPRING_PROFILES_ACTIVE=
